# Local-only notes. Markdown is otherwise tracked: an allowlist of *.md
# with per-file exceptions silently dropped new docs that tracked pages
# linked to (docs/migration-to-1.0.md and others). Name scratch notes
# *.local.md, or put them under /notes/, to keep them out of git.
*.local.md
/notes/
.commandcode/
# pilot 001 artifacts live on the pilot-001 branch and stay out of main
research/pilots/arabic_quantization_001/
/REPRODUCIBILITY.md
/ARTIFACT_STATUS.md
__pycache__/
.pytest_cache/
*.egg-info/

# gitingest snapshot
snapshot.txt
ingest.py

# generated SVG assets
/SVGs/

# paper source is tracked; latex build junk is not
# NOTE: paper/ is fully ignored while the TACL submission is under review.
# Remove the `/paper/` line (and the paper junk rules below) to track the
# paper source again after acceptance. The paper commit is preserved on the
# local-only `paper-private` branch.
/paper/
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bak
/paper/*.synctex.gz
/paper/*.zip
/paper/.codex/
/paper/.agents/
/paper/.deepseek/
# overleaf backup zip
/paper-overleaf.zip
# paper markdown is artifact content, not scratch
!paper/*.md

# regenerable probe activations anywhere under data/
data/**/*.npy
data/**/*.npz
data/**/activations.npy
data/**/*_activations_correctness.json
data/**/*_activations_metadata.json

# v0.3 ladder: the quantizer manifest is research data; the GGUFs stay ignored
!models/v03-ladder/ladder-manifest.json
# v0.3 golden raw logits: reports/summaries are tracked, npys are regenerable
artifacts/golden-v03/*.npy
# v0.3 golden ember-side extraction dirs: regenerable, summaries are the evidence
artifacts/golden-v03/*/out/
artifacts/golden-v03/**/*.npy

# v0.4 benchmark evidence
!/artifacts/benchmark-v04/2026-08-04/SUMMARY.md

runs/
# giant per-op trace dumps (regeneration data, kept local; dossier is the citable summary)
artifacts/performance-baseline/2026-08-10/analysis-summary.json
artifacts/performance-baseline/2026-08-10/raw/*.trace.json

# v0.5 Gate-H bundles: the per-bundle model.json is a byte-identical GGUF
# metadata/architecture export; tracked specs/plans/summaries are the citable
# evidence and the export is regenerable locally.
/artifacts/benchmark-v05/**/model.json
# golden raw logits are regenerable via tools/logits_dump.c + llama.cpp
artifacts/golden-v03/**/*.bin
/artifacts/golden-v03/bin/
# stray local screenshot and cached paper under the docs vault
/docs/f9c1d7cc-*.png
/docs/vault-*/**/*.pdf

# Local research artifacts (pilots and working corpora) stay ignored. The
# frozen EmberSEC Phase I comparative record, including its injected harness,
# is intentionally published for reproducibility.
/research/*
!/research/embersec/
/research/embersec/*
!/research/embersec/comparative/
!/research/embersec/comparative/**
/research/embersec/comparative/**/__pycache__/
# The quantization-transfer study is published with its script, design and
# results; its bundles stay under runs/.
!/research/quant-attribution/
/research/quant-attribution/**/__pycache__/
# cargo-fuzz source is tracked; generated outputs and working corpora are not.
/fuzz/*
!/fuzz/
!/fuzz/Cargo.toml
!/fuzz/Cargo.lock
!/fuzz/fuzz_targets/
!/fuzz/fuzz_targets/*.rs
!/fuzz/README.md
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/corpus_work/
/tests/_embersec_harness.rs
/docs/road-to-1.0-plan.html

# collaboration guidance is intentionally tracked despite the broad Markdown ignore
!/.github/PULL_REQUEST_TEMPLATE.md
!docs/audits/
!docs/audits/*.md
!docs/adr/
!docs/adr/*.md

!docs/road-to-1.0.md
!docs/release-1.0.md

.DS_Store

# Native console visual-test artifacts. `ember gui --render-test-dir` writes
# these; they are a deterministic local baseline for reviewing layout changes,
# not shipped content. Regenerate with:
#   cargo build --features gui-tests --bin ember
#   ./target/debug/ember gui --render-test-dir docs/screenshots/console
docs/screenshots/console/
docs/screenshots/console-shell/
# Render-harness passes written under artifacts/gui/ are local review
# material too. Already-tracked captures stay tracked; force-add a new one
# (git add -f) when it is meant to ship.
/artifacts/gui/*/

# Local working notes for the current UI pass; not documentation.
/nextsteps.md
