# paper source is tracked; latex build junk is not
# NOTE: paper/ is fully ignored while the TACL submission is under review.
# Remove the `/paper/` line (and the paper junk rules below) to track the
# paper source again after acceptance. The paper commit is preserved on the
# local-only `paper-private` branch.
/paper/
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bak
/paper/*.synctex.gz
/paper/*.zip
/paper/.codex/
/paper/.agents/
/paper/.deepseek/
# overleaf backup zip
/paper-overleaf.zip
# paper markdown is artifact content, not scratch
!paper/*.md

# regenerable probe activations anywhere under data/
data/**/*.npy
data/**/*.npz
data/**/activations.npy
data/**/*_activations_correctness.json
data/**/*_activations_metadata.json

# v0.3 ladder: the quantizer manifest is research data; the GGUFs stay ignored
!models/v03-ladder/ladder-manifest.json
# v0.3 golden raw logits: reports/summaries are tracked, npys are regenerable
artifacts/golden-v03/*.npy
# v0.3 golden ember-side extraction dirs: regenerable, summaries are the evidence
artifacts/golden-v03/*/out/
artifacts/golden-v03/**/*.npy

# v0.4 benchmark evidence
!/artifacts/benchmark-v04/2026-08-04/SUMMARY.md

runs/
# giant per-op trace dumps (regeneration data, kept local; dossier is the citable summary)
artifacts/performance-baseline/2026-08-10/analysis-summary.json
artifacts/performance-baseline/2026-08-10/raw/*.trace.json

